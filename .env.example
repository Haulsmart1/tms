# Copy to .env.local and fill in. .env.local is gitignored; this template is not.

# --- Supabase (existing) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses Row Level Security entirely, so it must never reach the
# browser. No NEXT_PUBLIC_ prefix, deliberately, so Next cannot bundle it.
# Used by app/api/request-access/route.ts to write registration_requests, which
# is what keeps the honeypot and rate limit from being bypassable via the public
# anon key. Supabase dashboard: Project Settings, API, service_role.
SUPABASE_SERVICE_ROLE_KEY=

# --- Square (existing, sandbox) ---
SQUARE_SANDBOX_TOKEN=

# --- Resend: powers the landing "Request access" form ---
# API key from the Resend dashboard.
RESEND_API_KEY=
# The verified sender. Live sends require a domain verified in Resend with its
# DNS records added; until that is done, onboarding@resend.dev works for local
# development only and cannot deliver to arbitrary inboxes.
MAIL_FROM=onboarding@resend.dev
# Where access requests are emailed.
LEAD_INBOX=stuart@adrcarriers.net

# --- Microsoft Teams: lead notification / triage ---
# URL of the Power Automate ("Workflows") flow that posts new leads into the
# Teams chat. Create it from the chat: ... > Workflows > a "when a webhook
# request is received" template, then copy the trigger URL here. It is ALWAYS
# https (Microsoft-hosted) and it is a secret: anyone who has it can post to the
# chat, so treat it like a password and never expose it client-side. Leave blank
# to disable the Teams notification entirely (the lead still stores).
TEAMS_WEBHOOK_URL=
