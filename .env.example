# Copy to .env.local and fill in. .env.local is gitignored; this template is not.

# --- Supabase (existing) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Square (existing, sandbox) ---
SQUARE_SANDBOX_TOKEN=

# --- Resend: powers the landing "Request access" form ---
# API key from the Resend dashboard.
RESEND_API_KEY=
# The verified sender. Live sends require a domain verified in Resend with its
# DNS records added; until that is done, onboarding@resend.dev works for local
# development only and cannot deliver to arbitrary inboxes.
MAIL_FROM=onboarding@resend.dev
# Where access requests are emailed.
LEAD_INBOX=stuart@adrcarriers.net
